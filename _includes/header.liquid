<header>
  <nav class="site-nav" aria-label="Main">
    <div class="container site-nav-inner">
      {% unless page.url == '/' %}
        <a class="site-name" href="{{ '/' | relative_url }}">{{ site.title }}</a>
      {% endunless %}
      <ul class="site-links">
        {% assign sorted_pages = site.pages | sort: 'nav_order' %}
        {% for p in sorted_pages %}
          {% if p.nav and p.autogen == null %}
            {% assign is_current = false %}
            {% if p.url == '/' %}
              {% if page.url == '/' %}{% assign is_current = true %}{% endif %}
            {% elsif page.url contains p.url %}
              {% assign is_current = true %}
            {% endif %}
            <li>
              <a
                class="site-link"
                href="{{ p.url | relative_url }}"
                {% if is_current %}
                  aria-current="page"
                {% endif %}
              >
                {{- p.title -}}
              </a>
            </li>
          {% endif %}
        {% endfor %}
        {% if site.enable_darkmode %}
          <li>
            <button id="light-toggle" class="site-theme" type="button" title="Change theme" aria-label="Change theme">
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/>
                <path d="M8 1.75a6.25 6.25 0 0 0 0 12.5z" fill="currentColor"/>
              </svg>
            </button>
          </li>
        {% endif %}
      </ul>
    </div>
  </nav>
</header>
