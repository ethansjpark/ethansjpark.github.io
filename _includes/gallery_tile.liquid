{%- assign ar = include.p.width | times: 1.0 | divided_by: include.p.height -%}
<a class="g-tile" style="--ar:{{ ar | round: 4 }}" href="{{ include.p.url | relative_url }}"><img src="{{ include.p.image | relative_url }}" width="{{ include.p.width }}" height="{{ include.p.height }}" alt="{{ include.p.title }}" loading="lazy"><span class="g-ov"><b>{{ include.p.title }}</b><i>{{ include.p.city }}, {{ include.p.date | date: "%Y" }}</i></span></a>
