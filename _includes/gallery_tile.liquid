{%- assign grow = include.p.width | times: 100.0 | divided_by: include.p.height | round -%}
<a class="g-tile" style="flex-grow:{{ grow }};aspect-ratio:{{ include.p.width }} / {{ include.p.height }}" href="{{ include.p.url | relative_url }}"
  ><img
    src="{{ include.p.thumb | default: include.p.image | relative_url }}"
    width="{{ include.p.width }}"
    height="{{ include.p.height }}"
    alt="{{ include.p.title }}"
    loading="lazy"

  ><span class="g-ov"
    ><b>{{ include.p.title }}</b><i>{{ include.p.city }}, {{ include.p.date | date: '%Y' }}</i></span
  ></a
>
