---
---
<div class="pub" id="{{ entry.key }}">
  <div class="pub-year">{{ entry.year }}</div>
  <div class="pub-main">
    <div class="pub-title">{{ entry.title }}</div>

    <div class="pub-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- assign author_is_self = false -%}
        {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- if forloop.length == 2 and forloop.last %}
          and&nbsp;
        {%- elsif forloop.length > 2 and forloop.last -%}
          , and&nbsp;
        {%- elsif forloop.first == false -%}
          ,
        {% endif -%}
        {%- if author_is_self -%}
          <span class="pub-self">
            {{- author.first }}
            {{ author_last_html -}}
          </span>
        {%- else -%}
          {{ author.first }}
          {{ author_last_html }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign proceedings = 'inproceedings,incollection' | split: ',' -%}
    {%- assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' -%}
    {%- assign venue = '' -%}
    {%- if entry.type == 'article' -%}
      {%- assign venue = entry.journal -%}
    {%- elsif proceedings contains entry.type -%}
      {%- assign venue = entry.booktitle | prepend: 'In ' -%}
    {%- elsif thesis contains entry.type -%}
      {%- assign venue = entry.school -%}
    {%- endif -%}
    {%- if entry.location -%}
      {%- assign venue = venue | append: ', ' | append: entry.location -%}
    {%- endif -%}
    {%- if venue != blank -%}
      <div class="pub-venue">{{ venue | strip }}</div>
    {%- endif -%}
    {%- if entry.note -%}
      <div class="pub-venue">{{ entry.note | strip }}</div>
    {%- endif -%}

    <div class="pub-links">
      {%- if entry.pdf -%}
        {%- if entry.pdf contains '://' -%}
          <a href="{{ entry.pdf }}">Paper</a>
        {%- else -%}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">Paper</a>
        {%- endif -%}
      {%- endif -%}
      {%- if entry.bibtex_show -%}
        <a class="bibtex" href="javascript:void(0)" role="button">BibTeX</a>
      {%- endif -%}
    </div>

    {%- if entry.bibtex_show -%}
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {%- endif -%}
  </div>
</div>
